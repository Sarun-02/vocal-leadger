# Optional configuration. Copy to `.env.local` and fill in. Never commit real values.
#
# VITE_AI_PARSER_URL — an HTTPS endpoint that YOU host which turns a voice transcript
# into structured transactions. The app POSTs:
#   {"transcript": "...", "today": "YYYY-MM-DD"}
# and expects:
#   {"transactions": [{"type": "expense|income", "amount": 250, "category": "food",
#                      "description": "Lunch", "date": "YYYY-MM-DD", "paymentMethod": "upi"}]}
#
# Keep any LLM/API keys on that server. Every VITE_* value is bundled into the APK
# and readable by anyone who unpacks it, so never put secrets here.
# Leave empty to use only the built-in offline parser (the default).
VITE_AI_PARSER_URL=
